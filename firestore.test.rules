rules_version = '2';

// Permissive rules used ONLY by the local Firestore emulator when running
// smoke tests (see firebase.emulator.json). These intentionally bypass the
// real security rules in firestore.rules so tests exercise Firestore
// behavior (queries, transactions, batches) rather than auth/rules logic,
// which is covered separately by the firestore-rules CI job.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
